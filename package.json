{
  "name": "asia-travel-atlas",
  "version": "0.0.0",
  "scripts": {
    "ng": "node ./node_modules/@angular/cli/bin/ng.js",
    "start": "node ./server/dev-server.mjs",
    "media": "node ./server/media-server.mjs",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build",
    "watch": "node ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "node ./node_modules/@angular/cli/bin/ng.js test",
    "generate:map": "node ./scripts/generate-world-maps.mjs",
    "generate:china-map": "node ./scripts/generate-china-map.mjs",
    "generate:thailand-map": "node ./scripts/generate-thailand-map.mjs",
    "test:thailand-map": "node --test ./scripts/test-thailand-map.mjs",
    "test:china-map": "node --test ./scripts/test-china-map.mjs",
    "test:beijing-plan": "node --test ./scripts/test-beijing-plan.mjs",
    "test:daily-expenses": "node --test ./scripts/test-daily-expenses.mjs",
    "test:media-requests": "node --test ./scripts/test-media-requests.mjs",
    "test:browser-media": "node --test ./scripts/test-browser-media.mjs",
    "test:r2": "node --test ./scripts/test-r2-storage.mjs ./scripts/test-r2-media.mjs",
    "test:requirements": "node --test ./scripts/test-requirements.mjs ./scripts/test-requirement-attachments.mjs ./scripts/test-r2-public-url.mjs",
    "test:page-background": "node --test ./scripts/test-page-background.mjs",
    "migrate:media": "node ./scripts/migrate-media-to-r2.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@supabase/supabase-js": "2.99.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tha": "^1.0.0",
    "bootstrap": "^5.3.8",
    "driver.js": "^1.8.0",
    "flag-icons": "^7.5.0",
    "i18n-iso-countries": "^7.14.0",
    "maplibre-gl": "^6.9.0",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "d3-geo": "^3.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "world-countries": "^5.1.0"
  }
}
