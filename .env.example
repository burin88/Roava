# Server-only Cloudflare R2 configuration. Copy to .env and replace these values.
CLOUDFLARE_R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
CLOUDFLARE_R2_BUCKET_NAME=myapp-storage
# Optional: defaults to https://<AccountId>.r2.cloudflarestorage.com
CLOUDFLARE_R2_SERVICE_URL=
# Optional public delivery origin for Requirement image URLs (custom domain or r2.dev).
# This is separate from the S3 endpoint and does not enable public bucket access.
R2_PUBLIC_BASE_URL=

# Supabase public application configuration (safe for browsers).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional: Auth UID that owns photos uploaded before Auth was introduced.
# Leave blank for a new installation. Never accept this value from request headers.
R2_LEGACY_OWNER_ID=
# Cloudflare Pages: set both variables above in the deployment environment too.
# With an R2 binding, also set this to the bound bucket's actual name.
# Locally the existing CLOUDFLARE_R2_BUCKET_NAME above is used.
